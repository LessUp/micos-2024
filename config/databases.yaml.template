# MICOS-2024 数据库配置文件模板
# 复制此文件为 databases.yaml 并修改为实际的数据库路径
#
# ✅ 本模板只包含已接入 CLI 的字段（enforce-effective-configuration）：
#     quality_control.kneaddata.human_genome
#     taxonomy.kraken2.standard
#   生产配置对未知字段 fail-closed（extra="forbid"），模板外字段会被拒绝。
#   其余愿景数据库（QIIME2 分类器、HUMAnN、KEGG、COG、CARD、宿主基因组等）
#   见 docs/zh/roadmap.md，接入对应步骤后再放回模板。
#
# ⚠️ YAML 不支持 ${VAR} 变量插值：请将下方 ${database_root} 替换为实际的
#    数据库根目录绝对路径（例如 /home/user/micos_databases）。

# 质量控制数据库
quality_control:
  # KneadData 数据库（micos.quality_control 使用）
  kneaddata:
    human_genome: "${database_root}/kneaddata/human_genome"

# 分类学数据库
taxonomy:
  # Kraken2 数据库（micos.taxonomic_profiling 使用）
  # 使用: scripts/download_databases.sh kraken2-minikraken
  kraken2:
    standard: "${database_root}/kraken2/standard"
