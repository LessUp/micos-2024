# MICOS-2024 数据库配置文件模板
# 复制此文件为 databases.yaml 并修改为实际的数据库路径
#
# ⚠️ 注意: YAML 不支持 ${VAR} 变量插值。
# 请将下方所有 ${...} 占位符替换为实际的绝对路径。
# 使用 scripts/download_databases.sh 可自动下载常用数据库。
#
# ⚠️ 当前 CLI (micos.config.merge_databases_config) 仅读取以下字段：
#     quality_control.kneaddata.human_genome
#     taxonomy.kraken2.standard
#   其他数据库（QIIME2 分类器、HUMAnN、KEGG、COG、CARD、宿主基因组等）
#   尚未接入主链路，对应步骤（多样性/功能注释）使用命令行参数或工具默认值。

# 数据库根目录 - 修改为您的实际路径 (例如: /home/user/micos_databases)
database_root: "/path/to/micos_databases"

# ============================================================================
# ✅ 实际生效字段
# ============================================================================

# 质量控制数据库
quality_control:
  # KneadData 数据库（micos.quality_control 使用）
  kneaddata:
    human_genome: "${database_root}/kneaddata/human_genome"
    # 扩展数据库（当前未使用，按需启用）：
    # mouse_genome: "${database_root}/kneaddata/mouse_genome"
    # ribosomal_rna: "${database_root}/kneaddata/ribosomal_rna"

# 分类学数据库
taxonomy:
  # Kraken2 数据库（micos.taxonomic_profiling 使用）
  # 使用: scripts/download_databases.sh kraken2-minikraken
  kraken2:
    standard: "${database_root}/kraken2/standard"
    # 变体数据库（当前未使用，按需启用）：
    # minikraken: "${database_root}/kraken2/minikraken"
    # pluspf: "${database_root}/kraken2/pluspf"
    # pluspfp: "${database_root}/kraken2/pluspfp"

