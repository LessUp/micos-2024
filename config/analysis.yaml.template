# MICOS-2024 分析配置文件模板
# 复制此文件为 analysis.yaml 并根据需要修改参数
#
# ✅ 本模板只包含已接入 CLI 的字段（enforce-effective-configuration）：
#     paths.input_dir / paths.output_dir / paths.databases.{kneaddata,kraken2}
#     resources.max_threads
#   生产配置对未知字段 fail-closed（extra="forbid"），模板外字段会被拒绝。
#   其余愿景参数（QC 阈值、Kraken2 confidence、QIIME2 指标、HUMAnN/DESeq2、
#   max_memory/max_time 等）见 docs/zh/roadmap.md，接入对应 CLI 后再放回模板。

# 输入输出路径
paths:
  input_dir: "data/raw_input"
  output_dir: "results"

  # 数据库路径（也可在 databases.yaml 中配置，二者任选其一）
  databases:
    kneaddata: "/path/to/kneaddata_db"
    kraken2: "/path/to/kraken2_db"

# 计算资源配置
resources:
  max_threads: 16
